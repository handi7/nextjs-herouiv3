{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "app/globals.css",
  "tailwindFunctions": ["cn", "tv"],
  "importOrder": [
    "^type$",
    "^node:",
    "^(react|next|@next)/",
    "^(@?\\w)",
    "^\\.\\.(?!/?$)",
    "^\\./(?=.*/)(?!/?$)",
    "^\\.(?!/?$)",
    "^@/(.*)$",
    "^\\u0000",
    "^.+\\.module\\.(css|scss)$",
    "^.+\\.(css|scss)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
